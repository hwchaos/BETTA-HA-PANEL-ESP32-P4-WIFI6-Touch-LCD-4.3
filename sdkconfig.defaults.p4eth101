# SPDX-License-Identifier: LicenseRef-FNCL-1.1
# Waveshare ESP32-P4-ETH + 10.1-DSI-TOUCH-A (ESP32-P4-POE-ETH-KIT-B)
# 1280x800 MIPI-DSI, GT911, ES8311, IP101 Ethernet (no Wi-Fi coprocessor).
# Shares the MIPI-DSI display/touch driver with the 4.3" board.
CONFIG_IDF_TARGET="esp32p4"
CONFIG_APP_PANEL_BOARD_WAVESHARE_P4ETH101=y

CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_FREERTOS_ISR_STACKSIZE=6144
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# CONFIG_COMPILER_OPTIMIZATION_DEBUG is not set
# CONFIG_COMPILER_OPTIMIZATION_SIZE is not set

# --- Nano BSP: Waveshare 10.1" 800x1280 DSI panel ---
CONFIG_BSP_LCD_COLOR_FORMAT_RGB565=y
# CONFIG_BSP_LCD_COLOR_FORMAT_RGB888 is not set
CONFIG_BSP_LCD_TYPE_800_1280_10_1_INCH=y
CONFIG_BSP_LCD_MIPI_DSI_LANE_BITRATE_MBPS=1500

CONFIG_ESP_LCD_TOUCH_MAX_POINTS=5
CONFIG_LV_USE_LODEPNG=y
CONFIG_LV_USE_TINY_TTF=y

# P4 silicon revision 1.x (< 3.0)
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y

# LVGL memory (must match ui/lv_psram_mem.c)
# CONFIG_LV_USE_CLIB_MALLOC is not set
CONFIG_LV_USE_CUSTOM_MALLOC=y
CONFIG_LV_USE_FONT_COMPRESSED=y

CONFIG_ESP_HTTP_CLIENT_ENABLE_DIGEST_AUTH=y
CONFIG_VFS_MAX_COUNT=16

# --- Flash: 32 MB GD25Q256, own bootloader and partition table ---
# (partitions.p4eth101.csv; nvs and storage sit where the kit kept them.)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.p4eth101.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.p4eth101.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_BOOTLOADER_CACHE_32BIT_ADDR_QUAD_FLASH=y
# Quad I/O, as on the 4.3" board (same flash chip).
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
# CONFIG_ESPTOOLPY_FLASHMODE_DIO is not set

# OTA safety net: a new image must confirm itself (network up) or the
# bootloader falls back to the previous one.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# Rollback + QIO make the bootloader outgrow its 24 KB slot before the
# partition table; warnings-only logging keeps it in.
# CONFIG_BOOTLOADER_LOG_LEVEL_INFO is not set
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y

# Ethernet (internal EMAC + IP101 PHY)
CONFIG_ETH_ENABLED=y
CONFIG_ETH_USE_ESP32_EMAC=y

CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255

# Logging (same as 7B)
# CONFIG_LOG_MAXIMUM_EQUALS_DEFAULT is not set
CONFIG_LOG_MAXIMUM_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL=3
CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_LEVEL_WARN=y
CONFIG_LV_LOG_LEVEL=2
CONFIG_LV_LOG_USE_TIMESTAMP=y
CONFIG_LV_LOG_USE_FILE_LINE=y

# Crash core dump to flash (coredump partition), as on the 4.3" board.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
# CONFIG_ESP_COREDUMP_ENABLE_TO_UART is not set
# CONFIG_ESP_COREDUMP_ENABLE_TO_NONE is not set
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y
# CONFIG_ESP_COREDUMP_CAPTURE_DRAM is not set
CONFIG_ESP_COREDUMP_CHECK_BOOT=y
CONFIG_ESP_COREDUMP_LOGS=y
CONFIG_ESP_COREDUMP_MAX_TASKS_NUM=24
