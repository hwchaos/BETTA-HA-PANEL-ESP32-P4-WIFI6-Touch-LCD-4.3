# SPDX-License-Identifier: LicenseRef-FNCL-1.1
# Waveshare ESP32-P4-ETH + 10.1-DSI-TOUCH-A (ESP32-P4-POE-ETH-KIT-B)
# 1280x800 MIPI-DSI, GT911, ES8311, IP101 Ethernet (no Wi-Fi coprocessor).
# Sub-variant of the 7B build (same display/touch/audio code paths).
CONFIG_IDF_TARGET="esp32p4"
CONFIG_APP_PANEL_VARIANT_7INCH_1024=y
# CONFIG_APP_PANEL_VARIANT_4INCH_720 is not set
CONFIG_APP_PANEL_BOARD_WAVESHARE_P4ETH101=y
# CONFIG_APP_FEATURE_LOCAL_CAMERA is not set

CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_FREERTOS_ISR_STACKSIZE=6144
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# CONFIG_COMPILER_OPTIMIZATION_DEBUG is not set
# CONFIG_COMPILER_OPTIMIZATION_SIZE is not set

# --- Nano BSP: Waveshare 10.1" 800x1280 DSI panel ---
CONFIG_BSP_LCD_COLOR_FORMAT_RGB565=y
# CONFIG_BSP_LCD_COLOR_FORMAT_RGB888 is not set
CONFIG_BSP_LCD_TYPE_800_1280_10_1_INCH=y
CONFIG_BSP_LCD_MIPI_DSI_LANE_BITRATE_MBPS=1500

CONFIG_ESP_LCD_TOUCH_MAX_POINTS=5
CONFIG_LV_USE_LODEPNG=y
CONFIG_LV_USE_TINY_TTF=y

# P4 silicon revision 1.x (< 3.0)
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y

# LVGL memory (must match ui/lv_psram_mem.c)
# CONFIG_LV_USE_CLIB_MALLOC is not set
CONFIG_LV_USE_CUSTOM_MALLOC=y
CONFIG_LV_USE_FONT_COMPRESSED=y

CONFIG_ESP_HTTP_CLIENT_ENABLE_DIGEST_AUTH=y
CONFIG_VFS_MAX_COUNT=16

# --- Flash layout compatible with ESPHome (flash_size: 16MB) ---
# The kit arrives with ESPHome; its OTA writes this image into ESPHome's app
# slot and keeps ESPHome's bootloader and partition table. The table below is
# byte-identical to ESPHome's, so OTA keeps working in both directions. The
# LittleFS "storage" area lives in the upper 16 MB of the 32 MB chip and is
# registered at runtime (see app_main.c).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.esphome16.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.esphome16.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_SPI_FLASH_SIZE_OVERRIDE=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_BOOTLOADER_CACHE_32BIT_ADDR_QUAD_FLASH=y

# OTA safety net: a new image must confirm itself (network up) or the
# bootloader falls back to the previous one (ESPHome on the first install).
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Ethernet (internal EMAC + IP101 PHY)
CONFIG_ETH_ENABLED=y
CONFIG_ETH_USE_ESP32_EMAC=y

CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255

# Logging (same as 7B)
# CONFIG_LOG_MAXIMUM_EQUALS_DEFAULT is not set
CONFIG_LOG_MAXIMUM_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL=3
CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_LEVEL_WARN=y
CONFIG_LV_LOG_LEVEL=2
CONFIG_LV_LOG_USE_TIMESTAMP=y
CONFIG_LV_LOG_USE_FILE_LINE=y

# No coredump partition in ESPHome's table.
# CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH is not set
# CONFIG_ESP_COREDUMP_ENABLE_TO_UART is not set
CONFIG_ESP_COREDUMP_ENABLE_TO_NONE=y
