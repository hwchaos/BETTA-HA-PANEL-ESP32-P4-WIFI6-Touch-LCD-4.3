{
    "version": 3,
    "cmakeMinimumRequired": { "major": 3, "subMajor": 21, "patch": 0 },
    "configurePresets": [
        {
            "name": "panel43",
            "displayName": "Waveshare ESP32-P4-WIFI6-Touch-LCD-4.3",
            "description": "4.3\" 480x800 MIPI-DSI (used in landscape), Wi-Fi through the ESP32-C6.",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build-panel43",
            "cacheVariables": {
                "SDKCONFIG_DEFAULTS": "sdkconfig.defaults;sdkconfig.defaults.panel43",
                "SDKCONFIG": "${sourceDir}/sdkconfig.panel43"
            }
        },
        {
            "name": "p4eth101",
            "displayName": "Waveshare ESP32-P4-POE-ETH-KIT-B (10.1\")",
            "description": "10.1\" 800x1280 MIPI-DSI (used in landscape), Ethernet/PoE, ESPHome-compatible flash layout.",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build-p4eth",
            "cacheVariables": {
                "SDKCONFIG_DEFAULTS": "sdkconfig.defaults;sdkconfig.defaults.p4eth101",
                "SDKCONFIG": "${sourceDir}/sdkconfig.p4eth101"
            }
        }
    ]
}
