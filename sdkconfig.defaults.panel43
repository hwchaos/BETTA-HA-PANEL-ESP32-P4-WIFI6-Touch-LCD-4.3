# SPDX-License-Identifier: LicenseRef-FNCL-1.1
# Waveshare ESP32-P4-WIFI6-Touch-LCD-4.3 (480x800 MIPI-DSI ST7701, GT911)
CONFIG_IDF_TARGET="esp32p4"
CONFIG_APP_PANEL_BOARD_WAVESHARE_43=y

CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_FREERTOS_ISR_STACKSIZE=6144
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# CONFIG_COMPILER_OPTIMIZATION_DEBUG is not set
# CONFIG_COMPILER_OPTIMIZATION_SIZE is not set

CONFIG_ESP_LCD_TOUCH_MAX_POINTS=5
CONFIG_LV_USE_LODEPNG=y
# Runtime rendering of the full MDI icon font (tile icons from Home Assistant)
CONFIG_LV_USE_TINY_TTF=y

# P4 silicon revision 1.x (< 3.0)
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y

# LVGL memory (must match ui/lv_psram_mem.c)
# CONFIG_LV_USE_CLIB_MALLOC is not set
CONFIG_LV_USE_CUSTOM_MALLOC=y
CONFIG_LV_USE_FONT_COMPRESSED=y

CONFIG_ESP_HTTP_CLIENT_ENABLE_DIGEST_AUTH=y
CONFIG_VFS_MAX_COUNT=16

# 32 MB flash: 4-byte addressing
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_BOOTLOADER_CACHE_32BIT_ADDR_QUAD_FLASH=y

CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255

# Logging (same as 7B)
# CONFIG_LOG_MAXIMUM_EQUALS_DEFAULT is not set
CONFIG_LOG_MAXIMUM_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL=3
CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_LEVEL_WARN=y
CONFIG_LV_LOG_LEVEL=2
CONFIG_LV_LOG_USE_TIMESTAMP=y
CONFIG_LV_LOG_USE_FILE_LINE=y

# Crash core dump to flash (same as 7B)
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
# CONFIG_ESP_COREDUMP_ENABLE_TO_UART is not set
# CONFIG_ESP_COREDUMP_ENABLE_TO_NONE is not set
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y
# CONFIG_ESP_COREDUMP_CAPTURE_DRAM is not set
CONFIG_ESP_COREDUMP_CHECK_BOOT=y
CONFIG_ESP_COREDUMP_LOGS=y
CONFIG_ESP_COREDUMP_MAX_TASKS_NUM=24

# Flash in quad I/O (GD25Q256): ~19% more animation frames than DIO. The
# bootloader switches the chip to QIO, so the first change needs a USB flash;
# later OTA updates keep it.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
# CONFIG_ESPTOOLPY_FLASHMODE_DIO is not set

# OTA rollback: a new image runs as "pending" and confirms itself once Wi-Fi is
# up (main/diag/boot_guard.c); a restart before that boots the previous image.
# Needs the bootloader, so the first switch is a USB flash.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# Rollback makes the bootloader outgrow its 24 KB slot before the partition
# table; warnings-only logging keeps it in.
# CONFIG_BOOTLOADER_LOG_LEVEL_INFO is not set
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
