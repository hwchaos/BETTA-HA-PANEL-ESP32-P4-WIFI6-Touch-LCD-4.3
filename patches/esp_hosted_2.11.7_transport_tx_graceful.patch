diff --git a/managed_components/espressif__esp_hosted/host/drivers/transport/transport_drv.c b/managed_components/espressif__esp_hosted/host/drivers/transport/transport_drv.c
index fac29a1..4ca674a 100644
--- a/managed_components/espressif__esp_hosted/host/drivers/transport/transport_drv.c
+++ b/managed_components/espressif__esp_hosted/host/drivers/transport/transport_drv.c
@@ -28,6 +28,7 @@
 #include "esp_hosted_cli.h"
 #include "rpc_wrap.h"
 #include "esp_private/wifi.h"
+#include "esp_heap_caps.h" /* KB-PATCH: Tx alloc failure diagnostics */
 
 /**
  * @brief  Slave capabilities are parsed
@@ -253,6 +254,10 @@ static void transport_serial_free_cb(void *buf)
 	mempool_free(chan_arr[ESP_SERIAL_IF]->memp, buf);
 }
 
+/* KB-PATCH: how many Tx buffer failures have been logged so far. The log ring
+ * is small, so a failing stream must not be allowed to flush it. */
+static uint32_t tx_alloc_fail_log;
+
 static esp_err_t transport_drv_sta_tx(void *h, void *buffer, size_t len)
 {
 	void * copy_buff = NULL;
@@ -287,7 +292,31 @@ static esp_err_t transport_drv_sta_tx(void *h, void *buffer, size_t len)
 
 	/*  Prepare transport buffer directly consumable */
 	copy_buff = mempool_alloc(((struct mempool*)chan_arr[ESP_STA_IF]->memp), MAX_TRANSPORT_BUFFER_SIZE, true);
-	assert(copy_buff);
+	if (unlikely(!copy_buff)) {
+		// KB-PATCH: never abort on a failed Tx buffer allocation (upstream
+		// esp-hosted-mcu issue #144: assert(copy_buff) rebooted the panel when
+		// the internal DMA heap was momentarily exhausted). lwIP retransmits
+		// the dropped frame, which costs far less than a panic.
+		struct mempool *mp = (struct mempool*)chan_arr[ESP_STA_IF]->memp;
+#ifdef H_USE_MEMPOOL
+		uint32_t mp_in_use = mp ? (mp->alloc_count - mp->free_count) : 0;
+#else
+		uint32_t mp_in_use = 0;
+#endif
+		if (tx_alloc_fail_log < 8) {
+			tx_alloc_fail_log++;
+			ESP_LOGE(TAG, "Tx alloc of %u bytes failed (mp %p, in use %u): internal free %u, DMA free %u, DMA largest %u",
+					(unsigned)len, mp, (unsigned)mp_in_use,
+					(unsigned)heap_caps_get_free_size(MALLOC_CAP_INTERNAL),
+					(unsigned)heap_caps_get_free_size(MALLOC_CAP_INTERNAL | MALLOC_CAP_DMA),
+					(unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_INTERNAL | MALLOC_CAP_DMA));
+		}
+#if defined(ESP_ERR_ESP_NETIF_TX_FAILED)
+		return ESP_ERR_ESP_NETIF_TX_FAILED;
+#else
+		return ESP_ERR_ESP_NETIF_NO_MEM;
+#endif
+	}
 	g_h.funcs->_h_memcpy(copy_buff+H_ESP_PAYLOAD_HEADER_OFFSET, buffer, len);
 
 	return esp_hosted_tx(ESP_STA_IF, 0, copy_buff, len, H_BUFF_ZEROCOPY, copy_buff, transport_sta_free_cb, 0);
@@ -315,7 +344,15 @@ static esp_err_t transport_drv_ap_tx(void *h, void *buffer, size_t len)
 
 	/*  Prepare transport buffer directly consumable */
 	copy_buff = mempool_alloc(((struct mempool*)chan_arr[ESP_AP_IF]->memp), MAX_TRANSPORT_BUFFER_SIZE, true);
-	assert(copy_buff);
+	if (unlikely(!copy_buff)) {
+		// KB-PATCH: same graceful drop as the STA path (see transport_drv_sta_tx).
+		ESP_LOGE(TAG, "AP Tx alloc of %u bytes failed, dropping pkt", (unsigned)len);
+#if defined(ESP_ERR_ESP_NETIF_TX_FAILED)
+		return ESP_ERR_ESP_NETIF_TX_FAILED;
+#else
+		return ESP_ERR_ESP_NETIF_NO_MEM;
+#endif
+	}
 	g_h.funcs->_h_memcpy(copy_buff+H_ESP_PAYLOAD_HEADER_OFFSET, buffer, len);
 
 	return esp_hosted_tx(ESP_AP_IF, 0, copy_buff, len, H_BUFF_ZEROCOPY, copy_buff, transport_ap_free_cb, 0);
